<?xml version="1.0" encoding="UTF-8"?>
<!-- AEROSOUND factory preset. Values in real units (%, s, dB; key/chord/register are list indices). -->
<AeroSoundPreset name="Crystal Keys" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="aero" value="75"/>
  <PARAM id="balance" value="25"/>
  <PARAM id="air" value="50"/>
  <PARAM id="key" value="0"/>
  <PARAM id="chord" value="0"/>
  <PARAM id="ring" value="2.6"/>
  <PARAM id="strike" value="50"/>
  <PARAM id="sparkle" value="60"/>
  <PARAM id="register" value="1"/>
  <PARAM id="fizz" value="35"/>
  <PARAM id="size" value="40"/>
  <PARAM id="rise" value="50"/>
  <PARAM id="grain" value="30"/>
  <PARAM id="splash" value="40"/>
  <PARAM id="decay" value="3.0"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>

<?xml version="1.0" encoding="UTF-8"?>
<!-- AeroGlow example preset: gentle 2nd-harmonic warmth and air for lead vocals. -->
<AeroGlowPreset name="Sunlit Vocal" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="inputGain" value="0.0"/>
  <PARAM id="drive" value="12.0"/>
  <PARAM id="mix" value="35.0"/>
  <PARAM id="tone" value="15.0"/>
  <PARAM id="bias" value="-10.0"/>
  <PARAM id="mode" value="0"/>
  <PARAM id="highCut" value="12000.0"/>
  <PARAM id="lowProtect" value="90.0"/>
  <PARAM id="outputGain" value="0.0"/>
  <PARAM id="autoGain" value="1"/>
  <PARAM id="limiter" value="0"/>
  <PARAM id="oversampling" value="0"/>
</AeroGlowPreset>

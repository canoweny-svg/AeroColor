<?xml version="1.0" encoding="UTF-8"?>
<!-- AEROSOUND factory preset. Values in real units (%, s, dB; key/chord/register are list indices). -->
<AeroSoundPreset name="Glass Bus Gloss" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="aero" value="35"/>
  <PARAM id="balance" value="40"/>
  <PARAM id="air" value="30"/>
  <PARAM id="key" value="0"/>
  <PARAM id="chord" value="0"/>
  <PARAM id="ring" value="1.4"/>
  <PARAM id="strike" value="60"/>
  <PARAM id="sparkle" value="55"/>
  <PARAM id="register" value="1"/>
  <PARAM id="fizz" value="25"/>
  <PARAM id="size" value="40"/>
  <PARAM id="rise" value="45"/>
  <PARAM id="grain" value="50"/>
  <PARAM id="splash" value="35"/>
  <PARAM id="decay" value="2.0"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>

<?xml version="1.0" encoding="UTF-8"?>
<!-- AEROSOUND factory preset. Values in real units (%, s, dB; key/chord/register are list indices). -->
<AeroSoundPreset name="Underwater Bloops" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="aero" value="80"/>
  <PARAM id="balance" value="85"/>
  <PARAM id="air" value="40"/>
  <PARAM id="key" value="0"/>
  <PARAM id="chord" value="4"/>
  <PARAM id="ring" value="1.5"/>
  <PARAM id="strike" value="70"/>
  <PARAM id="sparkle" value="20"/>
  <PARAM id="register" value="0"/>
  <PARAM id="fizz" value="70"/>
  <PARAM id="size" value="85"/>
  <PARAM id="rise" value="80"/>
  <PARAM id="grain" value="10"/>
  <PARAM id="splash" value="70"/>
  <PARAM id="decay" value="2.5"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>

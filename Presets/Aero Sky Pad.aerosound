<?xml version="1.0" encoding="UTF-8"?>
<!-- AEROSOUND factory preset. Values in real units (%, s, dB; key/chord/register are list indices). -->
<AeroSoundPreset name="Aero Sky Pad" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="aero" value="75"/>
  <PARAM id="balance" value="50"/>
  <PARAM id="air" value="75"/>
  <PARAM id="key" value="0"/>
  <PARAM id="chord" value="1"/>
  <PARAM id="ring" value="3.0"/>
  <PARAM id="strike" value="15"/>
  <PARAM id="sparkle" value="45"/>
  <PARAM id="register" value="2"/>
  <PARAM id="fizz" value="60"/>
  <PARAM id="size" value="30"/>
  <PARAM id="rise" value="50"/>
  <PARAM id="grain" value="50"/>
  <PARAM id="splash" value="30"/>
  <PARAM id="decay" value="4.5"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>

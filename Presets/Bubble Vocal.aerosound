<?xml version="1.0" encoding="UTF-8"?>
<!-- AEROSOUND factory preset. Values in real units (%, s, dB; key/chord/register are list indices). -->
<AeroSoundPreset name="Bubble Vocal" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="aero" value="75"/>
  <PARAM id="balance" value="68"/>
  <PARAM id="air" value="55"/>
  <PARAM id="key" value="0"/>
  <PARAM id="chord" value="0"/>
  <PARAM id="ring" value="1.8"/>
  <PARAM id="strike" value="40"/>
  <PARAM id="sparkle" value="40"/>
  <PARAM id="register" value="1"/>
  <PARAM id="fizz" value="55"/>
  <PARAM id="size" value="35"/>
  <PARAM id="rise" value="60"/>
  <PARAM id="grain" value="80"/>
  <PARAM id="splash" value="45"/>
  <PARAM id="decay" value="3.2"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>

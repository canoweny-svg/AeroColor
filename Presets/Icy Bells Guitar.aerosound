<?xml version="1.0" encoding="UTF-8"?>
<!-- AEROSOUND factory preset. Values in real units (%, s, dB; key/chord/register are list indices). -->
<AeroSoundPreset name="Icy Bells Guitar" formatVersion="1" pluginVersion="1.0.0">
  <PARAM id="aero" value="70"/>
  <PARAM id="balance" value="20"/>
  <PARAM id="air" value="60"/>
  <PARAM id="key" value="0"/>
  <PARAM id="chord" value="3"/>
  <PARAM id="ring" value="4.0"/>
  <PARAM id="strike" value="75"/>
  <PARAM id="sparkle" value="80"/>
  <PARAM id="register" value="2"/>
  <PARAM id="fizz" value="25"/>
  <PARAM id="size" value="25"/>
  <PARAM id="rise" value="40"/>
  <PARAM id="grain" value="40"/>
  <PARAM id="splash" value="40"/>
  <PARAM id="decay" value="3.5"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>

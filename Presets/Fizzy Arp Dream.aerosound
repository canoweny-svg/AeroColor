  <PARAM id="strike" value="55"/>
  <PARAM id="sparkle" value="55"/>
  <PARAM id="register" value="2"/>
  <PARAM id="fizz" value="80"/>
  <PARAM id="size" value="20"/>
  <PARAM id="rise" value="70"/>
  <PARAM id="grain" value="60"/>
  <PARAM id="splash" value="60"/>
  <PARAM id="decay" value="3.8"/>
  <PARAM id="mix" value="100"/>
  <PARAM id="output" value="0"/>
</AeroSoundPreset>
